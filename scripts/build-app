#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PKG="$ROOT/app/SwitchPilot"
APP="$PKG/.build/SwitchPilot.app"
# shortcut: CLT lacks XCTest; native SwiftPM is the local fallback until full Xcode is available.
swift build --package-path "$PKG" --build-system native
BIN=$(swift build --package-path "$PKG" --build-system native --show-bin-path)
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN/SwitchPilot" "$APP/Contents/MacOS/SwitchPilot"
cp "$PKG/Info.plist" "$APP/Contents/Info.plist"
if [ -f "$PKG/Resources/AppIcon.icns" ]; then cp "$PKG/Resources/AppIcon.icns" "$APP/Contents/Resources/AppIcon.icns"; fi
find "$PKG/Resources" -maxdepth 1 -type d -name '*.lproj' -exec cp -R {} "$APP/Contents/Resources/" \;
SIGN_IDENTITY="${SWITCHPILOT_SIGN_IDENTITY:-}"
if [ -n "$SIGN_IDENTITY" ] && codesign --force --sign "$SIGN_IDENTITY" --options runtime --entitlements "$PKG/Entitlements.plist" "$APP" 2>/dev/null; then
    echo "signed with configured identity"
else
    codesign --force --sign - --options runtime --entitlements "$PKG/Entitlements.plist" "$APP"
    echo "signed ad-hoc (no stable identity configured)"
fi
codesign --verify --strict "$APP"
printf '%s\n' "$APP"
