#!/bin/sh
# Read-only onsite acceptance snapshot for SwitchPilot.
# Uses the running app's switchpilot://diagnose URL (or starts the app first);
# it does not grant/revoke TCC, lock, launch the screen saver or change appearance.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
APP="${SWITCHPILOT_APP:-$HOME/Applications/SwitchPilot.app}"
STAMP=$(date +%Y%m%d-%H%M%S)
OUT="${1:-$ROOT/evidence/raw/app/onsite-$STAMP.log}"
mkdir -p "$(dirname "$OUT")"
{
    printf '# SwitchPilot onsite probe %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
    printf 'app=%s\n' "$APP"
    printf '\n## build\n'
    /usr/bin/plutil -extract CFBundleShortVersionString raw "$APP/Contents/Info.plist" 2>/dev/null || true
    codesign -d -r- "$APP" 2>&1 | tail -1 || true
    shasum -a 256 "$APP/Contents/MacOS/SwitchPilot" 2>/dev/null || true
    printf '\n## process\n'
    pgrep -fl "SwitchPilot.app/Contents/MacOS/SwitchPilot" || true
    printf '\n## runtime diagnostic\n'
    rm -f /tmp/switchpilot-runtime-diagnose.txt
    if ! pgrep -f "SwitchPilot.app/Contents/MacOS/SwitchPilot" >/dev/null 2>&1; then
        open "$APP" >/dev/null 2>&1 || true
        sleep 2
    fi
    open "switchpilot://diagnose" >/dev/null 2>&1 || true
    sleep 2
    cat /tmp/switchpilot-runtime-diagnose.txt 2>/dev/null || echo 'diagnostic missing (run --diagnose-runtime or check URL registration)'
    # sfltool dumpbtm can hang on some macOS builds; keep the probe read-only and
    # bounded. The runtime diagnostic already reports SMAppService status.
    printf '\n## assertions\n'
    pmset -g assertions 2>/dev/null | grep -i SwitchPilot || echo 'no SwitchPilot assertions'
    printf '\n## TCC log tail (SwitchPilot, 5m)\n'
    log show --last 5m --predicate 'subsystem == "com.apple.TCC"' 2>/dev/null | grep -i 'SwitchPilot' | tail -20 || true
} > "$OUT"
printf '%s\n' "$OUT"
