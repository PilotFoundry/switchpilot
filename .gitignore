# Build output and per-user IDE state
.DS_Store
.build/
build/
DerivedData/
xcuserdata/
*.xcuserstate
node_modules/
.venv/
__pycache__/
*.pyc

# Local secrets and signing material
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
