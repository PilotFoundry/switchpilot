# Local tools, proprietary samples, and raw analysis projects
/.tools/
/samples/
/analysis/
/evidence/raw/
/evidence/private/
*.app/
*.dmg
*.zip

# local-agent-state runtime is local; reviewed plans are versioned
/local-agent-state/*
!/local-agent-state/plans/
/local-agent-state/plans/*
